#!/usr/bin/lua

--[[
	Installs what the announced prefixes need locally: a kernel route per
	range, and a firewall zone that lets the mesh reach it.

	001-reset-uci regenerates network and firewall from scratch on every
	gluon-reconfigure, so nothing has to be pruned here - only written.
]]

local uci = require('simple-uci').cursor()
local util = require 'gluon.util'
local l3routes = require 'gluon.l3routes'

local routes = l3routes.collect().routes

local ifaces = l3routes.interfaces()
local zones = l3routes.zones()

local function device_of(name)
	local iface = ifaces[name]
	return (iface and iface.device) or name
end

--[[
	A device with disable_ipv6 set takes no IPv6 route - netifd accepts the
	section, the kernel refuses the route, and the announcement points at
	nothing. br-client is exactly this on a layer-3 node, where l3roamd owns
	the client IPv6. Say so rather than leaving it silent.
]]
local function ipv6_disabled(device)
	local f = device and io.open('/proc/sys/net/ipv6/conf/' .. device .. '/disable_ipv6')
	if not f then
		return false
	end

	local value = f:read('*l')
	f:close()

	return value == '1'
end

local zone_networks, seen = {}, {}

--[[
	A prefix this node announces but cannot currently deliver must be dropped
	here, not handed back to the mesh.

	Without this the packet falls through to whatever covering route the mesh
	knows - the aggregate the announced address sits in - which points at a
	gateway that routes it straight back, and it bounces until its TTL runs
	out. So every announced prefix also gets an unreachable route, at a metric
	high enough that the real one wins whenever it is there. babeld does the
	same for the prefixes it originates.
]]
local UNREACHABLE_METRIC = 2000000000

-- before the main lookup at 32766, and clear of the rules gluon sets up for
-- the uplink at 10000 and 20000
local RULE_PRIORITY = 21000

for i, r in ipairs(routes) do
	--[[
		The configuration names a role; a route attaches to the network
		interface gluon put that role's ports into, and a zone or a macvlan is
		built on that interface's device.
	]]
	local network = (ifaces[r.interface] or {}).network or r.interface

	uci:section('network', r.family == 4 and 'route' or 'route6', ('l3routes_%d_null'):format(i), {
		interface = 'loopback',
		target = r.cidr,
		type = 'unreachable',
		metric = UNREACHABLE_METRIC,
	})

	-- an is_local prefix is an address netifd already put on the interface,
	-- so there is nothing to install - only something to announce
	if not r.is_local then
		uci:section('network', r.family == 4 and 'route' or 'route6', ('l3routes_%d'):format(i), {
			interface = network,
			target = r.cidr,
			gateway = r.gateway,
			--[[
				A next hop the kernel cannot place on the interface is refused
				with "Network unreachable"; naming both the interface and the
				next hop says where it is, which is what onlink means, and is
				how olsrd installs its own routes here.
			]]
			onlink = r.gateway and true or nil,
			metric = r.metric,
			--[[
				Left unset unless something was asked for: netifd reads "main"
				as "no table given" and then puts the route in the table the
				interface itself uses, so naming it would not mean what it says.
			]]
			table = r.table,
		})

		--[[
			netifd installs a route through a next hop only where it has an
			address that covers it - onlink or not. A mesh interface carries a
			/32, so nothing is ever within it and the route is quietly dropped.
		]]
		if r.gateway and l3routes.reaches(r.interface, r.gateway, ifaces) == false then
			util.log(('l3routes: %s has no address covering %s, so %s cannot be routed through it; '
				.. 'leave the next hop out to route onto the interface instead')
				:format(r.interface, r.gateway, r.cidr))
		end

		--[[
			An interface with a table of its own - gluon gives wan ip4table 1 -
			takes the route there instead of into main, and netifd cannot be
			told otherwise: it reads "main" as "no table given" and falls back
			to the interface's own.

			Which would leave the prefix announced and undeliverable, since
			forwarding looks in main. A rule for that destination sends the
			lookup to the table the route actually went to. It sits before the
			main lookup at 32766, and the unreachable route stays behind it as
			the fallback for when the real one is gone.
		]]
		local own_table = uci:get('network', network,
			r.family == 4 and 'ip4table' or 'ip6table')

		if not r.table and own_table then
			uci:section('network', r.family == 4 and 'rule' or 'rule6',
				('l3routes_%d_rule'):format(i), {
					dest = r.cidr,
					lookup = own_table,
					priority = RULE_PRIORITY + i,
				})

			util.log(('l3routes: %s keeps its routes in table %s, so %s is looked up there')
				:format(r.interface, own_table, r.cidr))
		end
	end

	if r.family == 6 and ipv6_disabled(device_of(r.interface)) then
		util.log(('l3routes: %s has IPv6 disabled on %s, %s cannot be routed there')
			:format(r.interface, device_of(r.interface), r.cidr))
	end

	if r.firewall and not seen[r.interface] then
		seen[r.interface] = true

		local zone = l3routes.zone_of(r.interface, zones, ifaces)

		if zone then
			--[[
				The interface is already in a zone - gluon's own uplink or
				client network, or one another package set up. Its policy is
				not ours to rewrite: putting br-wan into a second zone, or
				opening mesh to wan wholesale, would turn the node into a
				gateway for everything rather than for the prefix it
				announced.

				So only the announced prefix is let through, in the direction
				the announcement promises. Replies come back on conntrack.
			]]
			for _, peer in ipairs({ 'mesh', 'loc_client' }) do
				-- towards the prefix
				uci:section('firewall', 'rule', ('l3routes_%d_%s_in'):format(i, peer), {
					name = ('l3routes to %s via %s'):format(r.cidr, r.interface),
					src = peer,
					dest = zone,
					dest_ip = r.cidr,
					-- a rule without this covers tcp and udp only, and an
					-- announced prefix is reachable or it is not
					proto = 'all',
					family = 'ipv' .. r.family,
					target = 'ACCEPT',
				})

				--[[
					And back out of it. Replies ride conntrack, but what the
					prefix itself starts does not, and the zone it sits in
					forwards nothing by default - gluon's uplink zone ends in
					drop_to_wan. Without this the address can be reached and
					cannot answer for itself.
				]]
				uci:section('firewall', 'rule', ('l3routes_%d_%s_out'):format(i, peer), {
					name = ('l3routes from %s via %s'):format(r.cidr, r.interface),
					src = zone,
					src_ip = r.cidr,
					dest = peer,
					proto = 'all',
					family = 'ipv' .. r.family,
					target = 'ACCEPT',
				})
			end

			--[[
				And it must not be masqueraded on the way through: gluon
				masquerades everything leaving the uplink, which would hide
				every mesh client behind the node's own address. An announced
				prefix is routed, not translated - the device is meant to see
				who is talking to it.
			]]
			if r.family == 4 then
				uci:section('firewall', 'nat', ('l3routes_%d_nonat'):format(i), {
					name = ('l3routes no-nat %s'):format(r.cidr),
					src = zone,
					dest_ip = r.cidr,
					proto = 'all',
					target = 'ACCEPT',
				})
			end
		else
			table.insert(zone_networks, network)
		end
	end
end

uci:save('network')

if #zone_networks > 0 then
	table.sort(zone_networks)

	uci:section('firewall', 'zone', l3routes.ZONE, {
		name = l3routes.ZONE,
		network = zone_networks,
		input = 'REJECT',
		output = 'ACCEPT',
		forward = 'REJECT',
	})

	-- The same rule gluon gives every zone it creates (300-firewall-rules).
	-- Hosts inside an announced v6 range do neighbour discovery with this node
	-- as their router, so without this v6 in the range does not work at all.
	uci:section('firewall', 'rule', 'l3routes_ICMPv6_in', {
		src = 'l3routes',
		proto = 'icmp',
		icmp_type = {
			'echo-request',
			'echo-reply',
			'destination-unreachable',
			'packet-too-big',
			'time-exceeded',
			'bad-header',
			'unknown-header-type',
			'router-solicitation',
			'neighbour-solicitation',
			'router-advertisement',
			'neighbour-advertisement',
			'130/0', -- Multicast Listener Query
			'131/0', -- Multicast Listener Report
			'132/0', -- Multicast Listener Done
			'143/0', -- MLDv2
		},
		limit = '1000/sec',
		family = 'ipv6',
		target = 'ACCEPT',
	})

	uci:section('firewall', 'rule', 'l3routes_ICMPv4_in', {
		src = 'l3routes',
		proto = 'icmp',
		icmp_type = { 'echo-request' },
		family = 'ipv4',
		target = 'ACCEPT',
	})

	for _, pair in ipairs({
		{ 'mesh', 'l3routes' },
		{ 'l3routes', 'mesh' },
		{ 'loc_client', 'l3routes' },
		{ 'l3routes', 'loc_client' },
	}) do
		uci:section('firewall', 'forwarding', 'l3r_' .. pair[1] .. '_' .. pair[2], {
			src = pair[1],
			dest = pair[2],
		})
	end
end

uci:save('firewall')
