#!/usr/bin/lua

--[[
	Serve the config mode over TLS as well as plain HTTP.

	gluon-status-page's 500 deliberately clears listen_https, which is right for
	a status page anyone on the mesh may read. The config mode is not that: the
	proxy carries a session that changes this node's settings, so the hop it
	travels over is encrypted, and the proxy pins the certificate so it knows it
	reached this node and not something answering in its place.

	Runs after 500 on purpose - it is putting back what that one takes away.

	uhttpd generates the certificate itself, with px5g, the first time it starts
	with listen_https set and no certificate on disk.
]]

local uci = require('simple-uci').cursor()

uci:section('gluon-config-mode-remote', 'remote', 'remote', {})
uci:save('gluon-config-mode-remote')

uci:set_list('uhttpd', 'main', 'listen_https', { '0.0.0.0:443', '[::]:443' })

-- the defaults uhttpd generates a certificate from; without them it makes one
-- for "OpenWrt", which says nothing about which node answered
uci:section('uhttpd', 'cert', 'defaults', {
	days = '3650',
	key_type = 'ec',
	ec_curve = 'P-256',
	commonname = require('pretty_hostname').get(uci),
})

uci:save('uhttpd')

--[[
	443 wherever 80 already is.

	uhttpd was told to listen and nothing was told to let anyone in, so the
	proxy's TLS hop was refused in every zone - the port was open on the node
	and shut in the firewall. Which zones may reach the web server is the
	status page's decision (500-status-page writes a <zone>_http rule for
	each), so this follows it rather than having an opinion of its own: a site
	that opens 80 to the uplink gets 443 there too, and one that does not,
	does not.
]]
local zones = {}

uci:foreach('firewall', 'rule', function(rule)
	local zone = (rule['.name'] or ''):match('^(.+)_http$')
	if zone then
		table.insert(zones, zone)
	end
end)

for _, zone in ipairs(zones) do
	uci:section('firewall', 'rule', zone .. '_https', {
		src = zone,
		dest_port = '443',
		proto = 'tcp',
		target = 'ACCEPT',
	})
end

uci:save('firewall')
