#!/usr/bin/lua

--[[
	Print the SHA-256 fingerprint of this node's own web certificate.

	The provisioning client reports it, and the config-mode proxy pins to it -
	the certificate is self-signed, so its fingerprint is the only thing there
	is to check it against.

	It lives here rather than in gluon-provisioning so that reporting it costs
	that package no dependency: it runs this if it is installed, and reports
	nothing if it is not.
]]

local openssl = require 'openssl'

local CERT = '/etc/uhttpd.crt'

local f = io.open(CERT)

if not f then
	io.stderr:write(CERT .. ' does not exist yet\n')
	os.exit(1)
end

local pem = f:read('*a')
f:close()

local cert = openssl.x509.read(pem)

if not cert then
	io.stderr:write(CERT .. ' is not a certificate we can read\n')
	os.exit(1)
end

--[[
	Lowercase hex of the DER, which is what the proxy compares against.

	x509:digest returns the raw 32 bytes on lua-openssl 0.9.2 and hex on some
	later builds, so both are accepted rather than assuming one - printing raw
	bytes as if they were hex is silent nonsense, and the proxy would just
	refuse to connect with no clue why.
]]
local digest = cert:digest('sha256')

if #digest == 32 then
	digest = (digest:gsub('.', function(byte) return string.format('%02x', byte:byte()) end))
end

digest = digest:lower():gsub('[^%x]', '')

if #digest ~= 64 then
	io.stderr:write('unexpected digest length: ' .. #digest .. '\n')
	os.exit(1)
end

print(digest)
