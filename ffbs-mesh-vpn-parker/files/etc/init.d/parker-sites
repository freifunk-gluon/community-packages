#!/bin/sh /etc/rc.common
# SC2034,SC2154: /etc/rc.common imports this script and uses variables defined here
# shellcheck disable=SC2034,SC2154
# shellcheck shell="busybox sh"

# Multi-site operation (active/standby). Does nothing while the config
# service gives the node only one site.

START=99

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/share/lua/parker-sites.lua loop
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
