#!/usr/bin/lua

local site = require 'gluon.site'
local dhcp = require 'parker.dhcp'
local uci = require('simple-uci').cursor()

-- dnsmasq's name for DHCPv4 option 42 (RFC 2132).
local NTP_OPTION = 'option:ntp-server'

-- Option 42 carries IPv4 addresses only, so check_site.lua rejects
-- anything else in client_ntp_servers4.
local function client_ntp_servers()
	local servers = site.parker.client_ntp_servers4({})
	if #servers > 0 then
		return servers
	end

	-- Without client_ntp_servers4, pass on the first entry of ntp_servers
	-- unchecked, although ntp_servers is meant for the node's own clock.
	return { site.ntp_servers()[1] }
end

dhcp.set_client_option(uci, NTP_OPTION, client_ntp_servers())
