#!/usr/bin/lua

-- OpenWrt makes dnsmasq authoritative. A site whose nodes all get the same
-- range4 can switch this off with parker.dhcp_authoritative = false, see
-- docs/dhcp-gateway-change.md.

local site = require 'gluon.site'
local uci = require('simple-uci').cursor()

if site.parker.dhcp_authoritative(true) then
	os.exit(0)
end

local dnsmasq = uci:get_first('dhcp', 'dnsmasq')
if not dnsmasq then
	os.exit(0)
end

uci:set('dhcp', dnsmasq, 'authoritative', false)
uci:commit('dhcp')
