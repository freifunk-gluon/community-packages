#!/usr/bin/lua

-- The node routes for all clients of its batman-adv mesh. The kernel
-- default neighbour table limit (gc_thresh3 = 1024) is too small for a
-- large mesh: each IPv6 client has 2 to 3 addresses. When the table is
-- full, the kernel drops packets ("neighbour table overflow").
-- The limits scale with the RAM, because each entry uses up to 1 KiB.

local util = require('gluon.util')

local mem = util.get_mem_total() or 0

local thresh
if mem > 131072 then
	thresh = { 2048, 8192, 16384 }
elseif mem > 65536 then
	thresh = { 1024, 4096, 8192 }
else
	thresh = { 512, 2048, 4096 }
end

local f = io.open('/etc/sysctl.d/41-parker-neigh.conf', 'w')
f:write('# Generated by /lib/gluon/upgrade/260-parker-neigh-limits\n')
for _, family in ipairs({ 'ipv4', 'ipv6' }) do
	for i, value in ipairs(thresh) do
		f:write(string.format('net.%s.neigh.default.gc_thresh%d=%d\n', family, i, value))
	end
end
f:close()
