#!/bin/sh /etc/rc.common

# Router advertisements for the private network. gluon-radvd runs uradvd for
# the mesh's own prefix, and uradvd takes a single interface, so the private
# network gets an instance of its own.

USE_PROCD=1
START=51

start_service() {
	prefix="$(lua -e 'local p = require("gluon.privatenet"); io.write(p.public6(p.address6()) or "")' 2>/dev/null)"

	# Only a range that was actually assigned. One the node made up for itself
	# is not announced to the mesh either, so an address out of it would reach
	# no further than this node.
	[ -n "$prefix" ] || return 0

	procd_open_instance
	# -a is the prefix clients address themselves out of; there is no DHCPv6
	# here, dnsmasq on these images is built without it
	procd_set_param command /usr/sbin/uradvd -i br-private -a "$prefix"
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param stderr 1
	procd_close_instance
}
