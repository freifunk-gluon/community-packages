#!/usr/bin/lua

-- The private network itself: a bridge over the interfaces gluon gave the
-- private role, with addresses, DHCP and a way out through the mesh.
--
-- Nothing here needs a radio. ffgraz-private-ap puts an access point onto it
-- where the node has one, and on a node without wifi the network is still
-- there for whatever is plugged into those ports.

local uci = require("simple-uci").cursor()
local util = require 'gluon.util'
local privatenet = require 'gluon.privatenet'

local NETWORK = privatenet.NETWORK
local LEGACY = 'ap'

-- what the node was configured with before, including under the old name
local function previous(option)
	return uci:get('network_gluon-old', NETWORK, option)
		or uci:get('network_gluon-old', LEGACY, option)
end

uci:set('network', 'globals', 'ula_prefix',
	uci:get('network_gluon-old', 'globals', 'ula_prefix'))

--[[
	An assigned IPv6 range goes on the bridge as it was given, and
	300-private-net.lua hands it to l3routes so the mesh routes it here. A made
	up one is left to ip6assign, which carves a piece off the node's own
	unique-local prefix - nothing outside the node knows it, so it is
	translated on the way out rather than announced.
]]
local address6 = previous('ip6addr')
local routed6 = privatenet.public6(address6)

local address4 = previous('ipaddr') or '192.168.66.1/24'
local routed4 = privatenet.routed4(address4)

uci:section('network', 'interface', NETWORK, {
	type = 'bridge',
	ifname = util.get_role_interfaces(uci, 'private'),
	proto = 'static',
	-- not 192.168.178.1/24: that is the default of the router most people
	-- have upstream, so the private network would land on the same subnet as
	-- the uplink and neither would be reachable from the other
	ipaddr = address4,
	ip6addr = routed6 and address6 or nil,
	ip6assign = not routed6 and '64' or nil,
})

-- dhcp is not regenerated on reconfigure, so the section under the old name
-- has to go or two servers end up on one bridge
uci:delete('dhcp', LEGACY)

-- a pool that does not fit inside the range leaves dnsmasq unable to hand out
-- a single address, so a range too small for one serves IPv6 only
local pool_start, pool_limit = privatenet.pool4(address4)

uci:section('dhcp', 'dhcp', NETWORK, {
	interface = NETWORK,
	start = pool_start and tostring(pool_start) or nil,
	limit = pool_limit and tostring(pool_limit) or nil,
	ignore = not pool_start and '1' or nil,
	leasetime = '12h',
	dhcpv4 = pool_start and 'server' or nil,
	dhcpv6 = 'server',
	ra = 'server',
	ra_slaac = '1',
	ra_flags = {
		'managed-config',
		'other-config',
	},
})

uci:section('firewall', 'zone', NETWORK, {
	name = NETWORK,
	network = { NETWORK },
	input = 'ACCEPT',
	output = 'ACCEPT',
	forward = 'ACCEPT',
})

-- A range out of the mesh's own prefix is announced by 300-private-net.lua and
-- routed back here, so translating it would only hide it. Anything else means
-- nothing to the other nodes and has to leave behind the node's address.
if not routed4 then
	uci:section('firewall', 'nat', 'private_masq', {
		name = 'private_masq',
		src = 'mesh',
		src_ip = address4,
		proto = 'all',
		target = 'MASQUERADE',
	})
end

uci:section('firewall', 'forwarding', 'private_to_mesh', {
	src = NETWORK,
	dest = 'mesh',
})

uci:save('firewall')
uci:save('network')
uci:save('dhcp')
