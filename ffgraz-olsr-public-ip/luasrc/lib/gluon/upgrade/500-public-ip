#!/usr/bin/lua

-- The tunnel the public address arrives through.
--
-- Announcing it is declared in /lib/gluon/l3routes/300-public-ip.lua, and the
-- rewrite forward mode needs in /lib/gluon/nftables/900-public-ip.lua.

local uci = require('simple-uci').cursor()
local l3routes = require 'gluon.l3routes'
local publicip = require 'gluon.publicip'

local config = publicip.config()

if config then
	uci:section('network', 'interface', publicip.INTERFACE, {
		proto = 'ipip',
		peeraddr = config.peeraddr,
		-- local mode terminates on the public address; forward mode on the
		-- node's own, since the packets are addressed to something this node
		-- does not have and the rewrite makes them match
		ipaddr = config.mode == 'forward' and config.node_ip4 or config.ip4,
	})

	-- Everything the address sends goes back out of the tunnel: a default
	-- route in a table of its own, and a rule picking it.
	uci:section('network', 'route', 'pubip_return', {
		interface = publicip.INTERFACE,
		target = '0.0.0.0/0',
		table = tostring(publicip.TABLE),
	})

	--[[
		The tunnel wraps what it sends in a packet from the same address, so
		without this the encapsulating packet matches the rule below and is
		routed straight back into the tunnel. In local mode that is where the
		address lives, so it loops: the device counted every reply as a
		transmit error and nothing left the node.
	]]
	uci:section('network', 'rule', 'pubip_peer_rule', {
		src = config.ip4 .. '/32',
		dest = config.peeraddr .. '/32',
		lookup = 'main',
		priority = publicip.RULE_PRIORITY - 1,
	})

	uci:section('network', 'rule', 'pubip_return_rule', {
		src = config.ip4 .. '/32',
		lookup = tostring(publicip.TABLE),
		priority = publicip.RULE_PRIORITY,
	})

	-- The encapsulated packets are addressed to the node and arrive over the
	-- mesh, and the mesh zone rejects what it was not told about - so the
	-- tunnel never saw them. Only ipip from the gateway is let in.
	uci:section('firewall', 'rule', 'public_ip_tunnel', {
		name = 'Allow the public IP tunnel',
		src = 'mesh',
		src_ip = config.peeraddr,
		proto = '4',
		family = 'ipv4',
		target = 'ACCEPT',
	})

	-- What comes out of the tunnel arrives on the tunnel device, which would
	-- otherwise be in no zone: nothing could be forwarded off it, and nothing
	-- addressed to the node itself would be answered.
	uci:section('firewall', 'zone', publicip.ZONE, {
		name = publicip.ZONE,
		network = { publicip.INTERFACE },
		input = 'REJECT',
		output = 'ACCEPT',
		forward = 'REJECT',
			})

	-- A public address that does not answer a ping looks dead. The rest of
	-- what reaches the node stays rejected.
	uci:section('firewall', 'rule', 'public_ip_icmp', {
		name = 'Allow ping to the public IP',
		src = publicip.ZONE,
		proto = 'icmp',
		icmp_type = { 'echo-request' },
		family = 'ipv4',
		target = 'ACCEPT',
	})

	-- Forwarding rides a macvlan child of the target interface, keeping the
	-- whole path out of that interface's policy. l3routes finds the device in
	-- no zone and gives it one, with the mesh forwardings on it.
	if config.mode == 'forward' then
		local parent = l3routes.interfaces()[config.target_interface]

		if parent and parent.device then
			uci:section('network', 'device', publicip.FORWARD_DEVICE_SECTION, {
				name = publicip.FORWARD_INTERFACE,
				type = 'macvlan',
				ifname = parent.device,
			})

			uci:section('network', 'interface', publicip.FORWARD_INTERFACE, {
				proto = 'static',
				device = publicip.FORWARD_INTERFACE,
				ipaddr = config.gateway,
				netmask = '255.255.255.255',
			})
		end

		for _, pair in ipairs({
			{ publicip.ZONE, l3routes.ZONE },
			{ l3routes.ZONE, publicip.ZONE },
		}) do
			uci:section('firewall', 'forwarding', ('pubip_%s_%s'):format(pair[1], pair[2]), {
				src = pair[1],
				dest = pair[2],
			})
		end

	else
		uci:delete('network', publicip.FORWARD_INTERFACE)
		uci:delete('network', publicip.FORWARD_DEVICE_SECTION)
	end

	-- ipaddr above is the tunnel's local endpoint, not an address the node
	-- carries, and the kernel only takes packets for a tunnel whose endpoint
	-- it owns - so in local mode the address goes on the device too.
	if config.mode == 'local' then
		uci:section('network', 'interface', publicip.ADDRESS_INTERFACE, {
			proto = 'static',
			device = '@' .. publicip.INTERFACE,
			ipaddr = config.ip4,
			netmask = '255.255.255.255',
		})
	else
		uci:delete('network', publicip.ADDRESS_INTERFACE)
	end
else
	uci:delete('network', publicip.INTERFACE)
	uci:delete('network', publicip.ADDRESS_INTERFACE)
	uci:delete('network', publicip.FORWARD_INTERFACE)
	uci:delete('network', publicip.FORWARD_DEVICE_SECTION)
	uci:delete('network', 'pubip_return')
	uci:delete('network', 'pubip_return_rule')
	uci:delete('network', 'pubip_peer_rule')
end

uci:save('network')
uci:save('firewall')
