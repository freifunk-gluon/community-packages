#!/bin/busybox sh

# Makes your current device blink

# shellcheck source=/dev/null
. /etc/diag.sh

MAC=$(cat /lib/gluon/core/sysconfig/primary_mac)

start() {
	set_state preinit
}

stop() {
	status_led_off
}

trap stop EXIT SIGTERM SIGINT
start

echo "Blinking on $(pretty-hostname) ($MAC) ... (ctrl-c to stop)"

sleep infinity
