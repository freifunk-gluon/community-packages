#!/usr/bin/lua

-- gluon-private-wifi puts the private SSID on wan. The network it belongs on
-- is ffgraz-private-net's, which exists with or without a radio. Runs after
-- 325-gluon-private-wifi, which is what creates the sections.

local uci = require("simple-uci").cursor()
local wireless = require 'gluon.wireless'

local NETWORK = 'private'

wireless.foreach_radio(uci, function(radio)
	local radio_name = radio['.name']
	local suffix = radio_name:match('^radio(%d+)$')
	local name = 'wan_' .. radio_name

	if not uci:get('wireless', name, 'device') then
		return
	end

	uci:set('wireless', name, 'ifname', suffix and 'ap' .. suffix)

	-- wireless is not regenerated on reconfigure, so an interface set up
	-- against the old network name is moved over
	uci:set('wireless', name, 'network', NETWORK)
end)

uci:save('wireless')
