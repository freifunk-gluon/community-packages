#!/usr/bin/lua

-- Announces what gluon.l3routes collected, as olsr HNAs.
--
-- Hna4 takes a dotted netmask, Hna6 a prefix length. The olsrd configurations
-- are not reset by 001-reset-uci, so what is written here carries a marker and
-- is pruned by it.

local uci = require('simple-uci').cursor()
local l3routes = require 'gluon.l3routes'

uci:delete_all('olsrd', 'Hna4', { gluon_l3routes = '1' })
uci:delete_all('olsrd6', 'Hna6', { gluon_l3routes = '1' })

local collected = l3routes.collect()

-- olsr carries IPv4 where it is enabled, and IPv6 only without babel: there
-- olsrd6 is not started at all and babel announces the v6 prefixes
local families = l3routes.families('olsr')

local n = 0

local function hna(p)
	if not families[p.family] then
		return
	end

	n = n + 1

	if p.family == 4 then
		uci:section('olsrd', 'Hna4', 'l3routes_' .. n, {
			gluon_l3routes = '1',
			netaddr = p.network,
			netmask = p.mask,
		})
	else
		uci:section('olsrd6', 'Hna6', 'l3routes_' .. n, {
			gluon_l3routes = '1',
			netaddr = p.network,
			prefix = tostring(p.plen),
		})
	end
end

for _, r in ipairs(collected.routes) do
	hna(r)
end

-- olsrd has no kernel route redistribution, so an import is snapshotted into
-- HNAs here. ponytail: refreshed on gluon-reconfigure only - making it live
-- would mean restarting olsrd per route change, and the real answer is an
-- olsrd plugin.
for _, imp in ipairs(collected.imports) do
	for _, p in ipairs(l3routes.resolve(imp)) do
		hna(p)
	end
end

uci:save('olsrd')
uci:save('olsrd6')

-- Only nudge a daemon that is already running: at boot this script runs from
-- uci-defaults, long before olsrd is meant to start.
os.execute('pgrep olsrd >/dev/null && /etc/init.d/olsrd reload >/dev/null 2>&1')
