#!/usr/bin/lua

--[[
	The node has one address per family and both live on loopback: the
	IPv6 one is put there by gluon-mesh-layer3-common (250-layer3-ip6),
	the IPv4 one by gluon-mesh-olsrd (350-gluon-mesh-olsrd-node-address),
	each derived from the node's MAC.

	This applies the operator's override on top, which is why it sits
	between the two: 250 sets ip6addr unconditionally, and 350 only fills
	in an address when loopback does not carry one already - so the list
	written here has to keep the shape 350 looks for.

	Nothing is put on the individual interfaces any more. olsrd6 and
	babel both mesh on the node address, and a per-interface address only
	gave the node more identities than it has.
]]

local ip = require 'luci.ip' -- luci-lib-ip
local uci = require('simple-uci').cursor()

local LOOPBACK4 = '127.0.0.1/8'

-- the node address is a single host, whatever prefix length it was entered with
local function host(address)
	return address and address:match('^[^/]+')
end

-- the section the config mode page writes into
uci:section('gluon-static-ip', 'interface', 'loopback', {})

-- the interfaces used to carry an address each, those sections are dead now
local stale = {}
uci:foreach('gluon-static-ip', 'interface', function(section)
	if section['.name'] ~= 'loopback' then
		table.insert(stale, section['.name'])
	end
end)

for _, name in ipairs(stale) do
	uci:delete('gluon-static-ip', name)
end

uci:save('gluon-static-ip')

local static4 = host(uci:get('gluon-static-ip', 'loopback', 'ip4'))
local static6 = host(uci:get('gluon-static-ip', 'loopback', 'ip6'))

if static4 then
	local address = ip.new(static4)

	if address and address:is4() then
		uci:set_list('network', 'loopback', 'ipaddr', { LOOPBACK4, static4 .. '/32' })
		uci:delete('network', 'loopback', 'netmask')
	else
		print('E: gluon-static-ip: ip4 ' .. static4 .. ' is not an IPv4 address')
	end
end

if static6 then
	local address = ip.new(static6)

	if address and address:is6() then
		uci:set('network', 'loopback', 'ip6addr', static6 .. '/128')
	else
		print('E: gluon-static-ip: ip6 ' .. static6 .. ' is not an IPv6 address')
	end
end

uci:save('network')
