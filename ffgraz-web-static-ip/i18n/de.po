msgid "Static IPs"
msgstr "Statische IPs"

msgid "Configure the IPv4 address of your node."
msgstr "Konfiguriere die IPv4 Addresse deines Knotens."

msgid "Configure the IPv6 address of your node."
msgstr "Konfiguriere die IPv6 Addresse deines Knotens."

msgid ""
"The address %s is in the temporary address range %s.<br />It should be "
"replaced by a properly assigned address as soon as possible."
msgstr ""
"Die Addresse %s ist eine Addresse aus dem temporären Addressbereich %s.<br />"
"Sie sollte umgehend mit einer korrekt zugewiesenen Addresse ersetzt werden."

msgid "IPv4 for this node"
msgstr "IPv4 für diesen Knoten"

msgid "IPv4 address (e.g. 1.2.3.4)"
msgstr "IPv4 Addresse (z.B. 1.2.3.4)"

msgid "IPv6 for this node"
msgstr "IPv6 für diesen Knoten"

msgid "IPv6 address (e.g. aa:bb:cc:dd:ee::ff)"
msgstr "IPv6 Addresse (z.B. aa:bb:cc:dd:ee::ff)"
