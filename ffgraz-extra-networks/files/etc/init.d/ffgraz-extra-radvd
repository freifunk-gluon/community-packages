#!/bin/sh /etc/rc.common

# Router advertisements for the node's own networks. gluon-radvd runs uradvd
# for the mesh's own prefix, and uradvd takes a single interface, so each of
# these gets an instance of its own.

USE_PROCD=1
START=51

start_service() {
	local network address prefix

	for network in private exposed; do
		# The prefix to advertise and the node's own address in it, kept in
		# plain variables: procd's own shell helpers work on "$@", so the
		# positional parameters are not ours to put things in. Through the
		# environment because a bare word after -e is taken as a script to
		# run, not as an argument to the one already given.
		prefix="$(NETWORK="$network" lua -e '
			local e = require("gluon.extranets")
			io.write((e.advertised6(os.getenv("NETWORK"))) or "")' 2>/dev/null)"
		address="$(NETWORK="$network" lua -e '
			local e = require("gluon.extranets")
			local _, host = e.advertised6(os.getenv("NETWORK"))
			io.write(host or "")' 2>/dev/null)"

		# Nothing to advertise until the network has a range
		[ -n "$prefix" ] || continue

		procd_open_instance "$network"
		# -a is the prefix clients address themselves out of; there is no
		# DHCPv6 here, dnsmasq on these images is built without it. The node
		# answers DNS on that address, so a client that only has IPv6 is not
		# left without a resolver.
		# Without a default lifetime uradvd advertises a router lifetime of
		# zero, which would leave clients on the prefix with no way off it.
		# A made up range gets one too: the node translates it on the way out
		# the same as it does the IPv4 one.
		procd_set_param command /usr/sbin/uradvd -i "br-$network" -a "$prefix" \
			--default-lifetime 900 --rdnss "$address"
		# Retries without end. This starts before netifd has built the
		# bridge, and uradvd exits when it has nothing to bind to: with a
		# retry limit procd gives up within the first half minute of every
		# boot and the network is left without advertisements for good.
		procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" 0
		procd_set_param stderr 1
		procd_close_instance
	done
}
