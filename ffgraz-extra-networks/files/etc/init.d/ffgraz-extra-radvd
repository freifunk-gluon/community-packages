#!/bin/sh /etc/rc.common

# Router advertisements for the node's own networks. gluon-radvd runs uradvd
# for the mesh's own prefix, and uradvd takes a single interface, so each of
# these gets an instance of its own.

USE_PROCD=1
START=51

start_service() {
	for network in private exposed; do
		# the prefix to advertise, and the node's own address in it
		set -- $(lua -e '
			local e = require("gluon.extranets")
			local address = e.address6(arg[1])
			local prefix = e.public6(address)
			if prefix then
				local host = address:gsub("/.*", "")
				io.write(prefix, " ", host)
			end' "$network" 2>/dev/null)

		# Only a range that was actually assigned. One the node made up for
		# itself is not announced to the mesh either, so an address out of it
		# would reach no further than this node.
		[ -n "$1" ] || continue

		procd_open_instance "$network"
		# -a is the prefix clients address themselves out of; there is no
		# DHCPv6 here, dnsmasq on these images is built without it. Without a
		# default lifetime uradvd advertises a router lifetime of zero, which
		# leaves clients on the prefix and with no way off it, and the node is
		# their router. It answers DNS on that address too, so a client that
		# only has IPv6 is not left without a resolver.
		procd_set_param command /usr/sbin/uradvd -i "br-$network" -a "$1" \
			--default-lifetime 900 --rdnss "$2"
		procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
		procd_set_param stderr 1
		procd_close_instance
	done
}
